{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hermes Loop Run Record",
  "type": "object",
  "required": [
    "loop_name",
    "run_id",
    "status",
    "trigger",
    "actions_taken",
    "verification",
    "stop_reason",
    "started_at",
    "ended_at",
    "hermes_profile",
    "loop_spec_version",
    "input_summary",
    "rollback_available"
  ],
  "properties": {
    "loop_name": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "success",
        "failed",
        "blocked",
        "DRY_RUN",
        "dry_run_example_complete"
      ]
    },
    "trigger": {
      "type": "string",
      "minLength": 1
    },
    "actions_taken": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "result",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "stop_reason": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "ended_at": {
      "type": "string",
      "minLength": 1
    },
    "hermes_profile": {
      "type": "string",
      "minLength": 1
    },
    "agent_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "loop_spec_version": {
      "type": "string",
      "minLength": 1
    },
    "input_summary": {
      "type": "string",
      "minLength": 1
    },
    "input_hashes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "hash"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "hash": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tool",
          "purpose",
          "result"
        ],
        "properties": {
          "tool": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "commands_run": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "exit_code"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "exit_code": {
            "type": "integer"
          },
          "evidence": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action",
          "scope",
          "status"
        ],
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "rollback": {
            "type": "string"
          },
          "expires_at": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "redactions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rollback_available": {
      "type": "boolean"
    },
    "rollback": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
